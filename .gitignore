# KiCad lock & autosave files (should never be version-controlled)
*.lck
~*.lck
_autosave-*
# LibreOffice lock files
.~lock.*#
# Editor local-history
.history/
# KiCad auto-backups & footprint cache (regenerated locally)
*-backups/
fp-info-cache
# KiCad manual / timestamped backups
*.bak
*.bak_*
*-PRE-RESTORE-*
# Per-machine KiCad UI state (zoom, layer visibility) - never share
*.kicad_prl
# Python cache & packaged fab output (regenerate from fabrication/v3/)
__pycache__/
fabrication.zip
